# ==============================================================================
# GridOS Environment Configuration
# ==============================================================================

# --- Application Mode ---
# Set to 'true' to run the built-in 10-meter simulator (offline / test mode)
VITE_USE_LOCAL_SIMULATOR=true

# --- MQTT Real-Time Telemetry Broker ---
# For production, use an authenticated private broker (EMQX, AWS IoT Core, or HiveMQ Cloud)
# Format: wss://your-broker-domain:8884/mqtt
VITE_MQTT_BROKER=
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
VITE_MQTT_TOPIC_PREFIX=gridios
VITE_SITE_ID=site-tz-001
VITE_OPERATOR_ID=op-jumeme-001

# --- Backend API URL ---
VITE_API_URL=http://localhost:4000

# --- Supabase Configuration (Edge Functions & Auth) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- ClickPesa Payment Gateway (Server-Side / Edge Functions) ---
# https://developer.clickpesa.com
CLICKPESA_API_KEY=
CLICKPESA_SECRET_KEY=
CLICKPESA_MERCHANT_ID=
CLICKPESA_WEBHOOK_SECRET=

# --- Google Maps API (Optional: Site Planning & GIS) ---
VITE_GOOGLE_MAPS_API_KEY=
