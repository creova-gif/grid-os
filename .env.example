# Copy to .env for local use. Commit this file only — never commit .env.
# Server-side secrets must not use a VITE_ or NEXT_PUBLIC_ prefix.
# Those prefixes are inlined into the browser bundle.

# Stripe API secret. Set in the Vercel project environment
# (Settings → Environment Variables), server-side only.
# Placeholder only:
STRIPE_SECRET_KEY=sk_live_xxx

# ClickPesa payment gateway. Read by Supabase Edge Functions
# (supabase/functions/server). Set as function secrets, server-side only.
CLICKPESA_API_KEY=pk_test_xxx
CLICKPESA_SECRET_KEY=your_clickpesa_secret_key
CLICKPESA_MERCHANT_ID=your_merchant_id

# Injected into Supabase Edge Functions. Server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Publishable client configuration for the Vite app on Vercel.
# These values are exposed to the browser. Do not put secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:4000
VITE_GOOGLE_MAPS_API_KEY=
VITE_MQTT_BROKER=wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_TOPIC_PREFIX=gridios
VITE_SITE_ID=site-tz-001
VITE_OPERATOR_ID=op-jumeme-001
VITE_USE_LOCAL_SIMULATOR=true
